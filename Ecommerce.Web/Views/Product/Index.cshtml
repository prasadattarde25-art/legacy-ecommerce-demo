@model Ecommerce.Core.ViewModels.ProductListViewModel
@{
    ViewBag.Title = "Products";
}
<h1>Products</h1>

@using (Html.BeginForm("Index", "Product", FormMethod.Get, new { id = "product-filter-form", @class = "form-inline filter-bar" }))
{
    <div class="form-group">
        <label for="categoryId">Category</label>
        @Html.DropDownList("categoryId",
            new SelectList(Model.Categories, "Id", "Name", Model.CategoryId),
            "All Categories",
            new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label for="q">Search</label>
        @Html.TextBox("q", Model.Query, new { @class = "form-control", placeholder = "Search products..." })
    </div>
    <button type="submit" class="btn btn-default">Filter</button>
}

<div id="product-grid">
    @Html.Partial("_ProductList", Model)
</div>

@section Scripts {
    <script>
        $(function () {
            // jQuery intercepts the filter form, sends an AJAX GET to
            // /Product/Filter and swaps the returned Razor partial into the grid.
            $('#product-filter-form').on('submit', function (e) {
                e.preventDefault();
                $('#product-grid').load('@Url.Action("Filter", "Product")?' + $(this).serialize());
            });
        });
    </script>
}