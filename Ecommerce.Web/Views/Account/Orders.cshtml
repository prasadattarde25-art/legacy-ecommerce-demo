@model Ecommerce.Core.ViewModels.OrderHistoryViewModel
@{
    ViewBag.Title = "Order History";
    ViewBag.FullWidth = true;
}
@section Styles {
    @Styles.Render("~/Content/datatables")
}

<h1>Order History</h1>
<p class="text-muted">
    Welcome back, @(Model.Customer != null ? Model.Customer.FirstName + " " + Model.Customer.LastName : "")!
</p>

@if (Model.Orders == null || Model.Orders.Count == 0)
{
    <p class="text-muted">You have no orders yet.</p>
    <a href="@Url.Action("Index", "Product")" class="btn btn-primary">Start Shopping</a>
}
else
{
    <table id="orders-table" class="table table-striped">
        <thead>
            <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Items</th>
                <th class="text-right">Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td data-order="@order.OrderDate.ToString("yyyy-MM-dd")">@order.OrderDate.ToString("MMM d, yyyy")</td>
                    <td>@order.ItemCount</td>
                    <td class="text-right">@order.GrandTotal.ToString("C")</td>
                    <td>@order.Status</td>
                    <td>@Html.ActionLink("View", "Confirmation", "Checkout", new { id = order.Id }, new { @class = "btn btn-xs btn-default" })</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    @Scripts.Render("~/bundles/datatables")
    <script>
        $(function () {
            $('#orders-table').DataTable({
                order: [[1, 'desc']]
            });
        });
    </script>
}